{
  "framework": "nextjs",
  "buildCommand": "pnpm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 8 * * 0"
    }
  ],
  "functions": {
    "src/app/api/ai/vision-stock/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ai/audio/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ai/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/webhooks/meta/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/email/sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/quotes/[id]/send/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/backup/route.ts": {
      "maxDuration": 60
    }
  }
}
