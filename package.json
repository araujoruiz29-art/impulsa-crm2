{
  "name": "caminante-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/prepare-db.mjs && prisma generate && next build",
    "vercel-build": "node scripts/prepare-db.mjs && prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start -p 3000",
    "db:push": "node scripts/prepare-db.mjs && prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "imapflow": "^1.0.180",
    "lucide-react": "^0.511.0",
    "mailparser": "^3.7.2",
    "next": "^16.4.6",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
